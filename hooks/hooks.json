{
  "description": "Inject the fixed lore context at Claude Code session start",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
